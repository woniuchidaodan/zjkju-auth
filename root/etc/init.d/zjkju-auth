#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	config_load zjkju-auth
	config_get_bool enabled main enabled 0

	# 留痕：谁在什么时候请求了启动，enabled 读到的是什么
	if [ "$enabled" != "1" ]; then
		logger -t zjkju-auth "start_service: enabled=[$enabled] 不启动"
		return 0
	fi
	logger -t zjkju-auth "start_service: 注册实例 (enabled=[$enabled])"

	procd_open_instance
	procd_set_param command /usr/bin/zjkju-auth-wrapper.sh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 留痕：每次停止都记录，便于追查"服务自己停了"的原因
	logger -t zjkju-auth "stop_service: 收到停止请求"
}
