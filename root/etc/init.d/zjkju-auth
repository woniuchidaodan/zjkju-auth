#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

# 【硬性约束】start_service 必须读磁盘上的 enabled 判断；
# 并且 on_after_commit 必须先 commit 再调用 start，否则这里会读到旧值。
start_service() {
	config_load zjkju-auth
	config_get_bool enabled main enabled 0

	# 留痕：谁在什么时候请求了启动，enabled 读到的是什么
	if [ "$enabled" != "1" ]; then
		logger -t zjkju-auth "start_service: enabled=[$enabled] 不启动"
		return 0
	fi
	logger -t zjkju-auth "start_service: 注册实例 (enabled=[$enabled])"

	procd_open_instance
	procd_set_param command /usr/bin/zjkju-auth-wrapper.sh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 留痕：每次停止都记录，便于追查"服务自己停了"的原因
	logger -t zjkju-auth "stop_service: 收到停止请求"
}

# 注意：这里不注册 procd_add_reload_trigger。
#
# 原因：wrapper 的主循环每轮都会重新读取配置（config_load），
# 学号 / 密码 / 服务类型 / 手动地址改了之后它自己就会用新值，
# 不需要重启。如果注册触发器，每次在 LuCI 保存配置都会重启服务，
# 日志里就会不断出现 "wrapper started"。
#
# 启停改由 model/cbi 的 on_after_commit 按「当前进程状态」决定：
#   未启用 → 启用   ：启动
#   启用 → 未启用   ：停止
#   状态没变        ：不动

reload_service() {
	logger -t zjkju-auth "reload_service: 配置变更，重启服务"
	stop
	start
}
